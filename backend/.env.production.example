NODE_ENV=production
PORT=10000
CLIENT_URL=https://mediaflow.sk-hub.in
CLIENT_URLS=https://mediaflow.sk-hub.in,https://www.mediaflow.sk-hub.in
CORS_ALLOWED_ORIGINS=https://mediaflow.sk-hub.in,https://www.mediaflow.sk-hub.in
DATABASE_NAME=sk_mediaflow
MONGODB_HOST=PASTE_MONGODB_CLUSTER_HOST
MONGODB_USERNAME=PASTE_MEDIAFLOW_MONGODB_USERNAME
MONGODB_PASSWORD=PASTE_MEDIAFLOW_MONGODB_PASSWORD
MONGODB_AUTH_SOURCE=admin
# Optional fallback when split MongoDB variables are not used:
# DATABASE_URL=mongodb+srv://username:password@cluster.example.mongodb.net/sk_mediaflow?retryWrites=true&w=majority
JWT_SECRET=PASTE_MEDIAFLOW_RANDOM_SECRET
CREDENTIAL_SECRET=PASTE_MEDIAFLOW_RANDOM_SECRET
SK_CENTRAL_SSO_SECRET=PASTE_SAME_VALUE_AS_SK_CENTRAL_SSO_TOKEN_SECRET
SK_CENTRAL_API_URL=https://www.sk-hub.in/api
RESEND_API_KEY=PASTE_SHARED_SK_CENTRAL_VALUE
EMAIL_FROM=PASTE_SHARED_SK_CENTRAL_MAIL_FROM
EMAIL_REPLY_TO=PASTE_REPLY_TO_ADDRESS
AWS_ACCESS_KEY=PASTE_MEDIAFLOW_VALUE
AWS_SECRET_KEY=PASTE_MEDIAFLOW_VALUE
AWS_REGION=PASTE_MEDIAFLOW_VALUE
AWS_BUCKET=PASTE_MEDIAFLOW_VALUE
CLOUDFRONT_DOMAIN=PASTE_MEDIAFLOW_VALUE
CLOUDFRONT_KEY_PAIR_ID=PASTE_MEDIAFLOW_VALUE
CLOUDFRONT_PRIVATE_KEY=PASTE_MEDIAFLOW_VALUE
REDIS_URL=PASTE_MEDIAFLOW_VALUE
GOOGLE_CLIENT_ID=PASTE_MEDIAFLOW_VALUE
GOOGLE_CLIENT_SECRET=PASTE_MEDIAFLOW_VALUE
GOOGLE_CALLBACK_URL=https://sk-mediaflow.onrender.com/api/auth/google/callback
OPENAI_API_KEY=PASTE_IF_AI_WORKER_IS_ENABLED
OPENAI_METADATA_MODEL=PASTE_MODEL_IF_AI_WORKER_IS_ENABLED
OPENAI_TRANSCRIPTION_MODEL=PASTE_MODEL_IF_AI_WORKER_IS_ENABLED
